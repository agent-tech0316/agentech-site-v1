  "dependencies": {
    "@foxglove/rosmsg": "5.0.5",
    "@foxglove/rosmsg2-serialization": "3.1.2",
    "@livekit/components-react": "^2.9.21",
    "livekit-client": "^2.20.0",
    "livekit-server-sdk": "^2.15.5",
    "next": "^15.5.20",
    "obs-websocket-js": "^5.0.8",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "22.13.14",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "adm-zip": "^0.5.17",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "^15.5.20",
    "nodemailer": "10.0.11",
    "postcss": "^8.5.19",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.2"
  }
}
