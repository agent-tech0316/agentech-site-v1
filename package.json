    "test:site-header-visibility": "node --experimental-strip-types --test lib/site-header-visibility.test.ts lib/service-navigation.test.ts lib/navigation-hover.test.ts",
    "test:robotics-mobile-products": "node --experimental-strip-types --test lib/robotics-product-browser.test.ts",
    "test:login-bypass": "node --experimental-strip-types --test lib/login-bypass.test.ts",
    "test:auth-sign-in": "node --experimental-strip-types --test scripts/auth-sign-in.test.mjs",
    "test:theme": "node --experimental-strip-types --test lib/theme.test.ts lib/theme-page-scopes.test.ts lib/about-news-themes.test.ts",
