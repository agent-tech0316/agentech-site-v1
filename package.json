    "test:talents-page": "node --test scripts/talents-page.test.mjs",
    "test:master-motor-map": "node --test scripts/master-motor-map.test.mjs",
    "test:master-live-camera": "node --test scripts/master-live-camera.test.mjs scripts/master-live-camera-state.test.mjs scripts/master-live-camera-ui.test.mjs scripts/master-livekit-track-state.test.mjs scripts/master-camera-web-service.test.mjs",
    "test:master-live-camera-gateway": "node --test scripts/master-live-camera-gateway.test.mjs",
