    "test:navi-cli-gateway": "python -m unittest scripts.test_trusted_navi_runner -q && node --test scripts/navi-cli-gateway.test.mjs",
    "test:return-to-home-access": "node --test scripts/return-to-home-access-policy.test.mjs",
    "test:sdk-reference": "node --test scripts/sdk-reference-consistency.test.mjs scripts/master-adjustment-profiles.test.mjs",
