    "test:navi-sdk-explorer-browser": "node scripts/navi-sdk-explorer-browser-check.mjs",
    "test:view-sdk-onboarding": "node --test scripts/view-sdk-onboarding-contract.test.mjs scripts/view-sdk-onboarding-ui.test.mjs",
